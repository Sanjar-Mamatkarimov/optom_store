SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,ваш-домен-или-ip

# Настройки PostgreSQL для Docker Compose. Для локального PostgreSQL задайте DB_ENGINE=postgresql.
POSTGRES_DB=optom_crm_db
POSTGRES_USER=optom_user
POSTGRES_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432

# Set USE_HTTPS=True only when the app is served over HTTPS; leave unset for local runserver.

# Доверенные источники для POST/форм (через запятую при необходимости)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1